# =============================================================================
# ENVIRONMENT VARIABLES - KONSER YUK BACKEND
# =============================================================================
# Copy file ini ke .env dan sesuaikan nilai-nilainya
# JANGAN commit file .env ke repository!
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION - MySQL Master/Slave Replication
# -----------------------------------------------------------------------------
# Master digunakan untuk operasi WRITE (INSERT, UPDATE, DELETE)
# Slave digunakan untuk operasi READ (SELECT) - mengurangi beban master
# -----------------------------------------------------------------------------
DB_NAME=konser_yuk
DB_USER=konseruser
DB_PASSWORD=konserpassword

# Untuk development lokal (non-Docker)
# DB_HOST=localhost
# DB_MASTER_HOST=localhost
# DB_SLAVE_HOST=localhost

# Untuk Docker environment (akan di-override di docker-compose.yml)
DB_MASTER_HOST=mysql-master
DB_SLAVE_HOST=mysql-slave

DB_PORT=3306

# -----------------------------------------------------------------------------
# JWT CONFIGURATION - Dual Token System
# -----------------------------------------------------------------------------
# Access Token: Token jangka pendek untuk autentikasi request (15 menit)
# Refresh Token: Token jangka panjang untuk mendapatkan access token baru (7 hari)
# GANTI secret ini dengan nilai random yang kuat di production!
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=your-super-secret-access-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production

# Durasi token (dalam format yang dipahami jsonwebtoken)
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# -----------------------------------------------------------------------------
# REDIS CONFIGURATION - Caching & Message Broker
# -----------------------------------------------------------------------------
# Redis digunakan untuk:
# 1. Cache-Aside pattern (caching data event)
# 2. Message Broker untuk BullMQ (antrian pembelian tiket)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispassword

# Cache TTL (Time To Live) dalam detik
CACHE_TTL=3600

# -----------------------------------------------------------------------------
# COOKIE CONFIGURATION - HttpOnly Cookies untuk JWT
# -----------------------------------------------------------------------------
# Domain tempat cookie akan di-set (gunakan domain production di prod)
COOKIE_DOMAIN=localhost

# Secure flag - set true di production (requires HTTPS)
COOKIE_SECURE=false

# SameSite policy untuk CSRF protection
COOKIE_SAMESITE=lax

# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# CORS - allowed origins (pisahkan dengan koma jika lebih dari 1)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# -----------------------------------------------------------------------------
# WORKER CONFIGURATION - BullMQ Worker
# -----------------------------------------------------------------------------
# Jumlah concurrent jobs yang diproses worker
WORKER_CONCURRENCY=5

# Job timeout dalam milidetik (30 detik)
JOB_TIMEOUT=30000

# -----------------------------------------------------------------------------
# EMAIL CONFIGURATION - Nodemailer (existing)
# -----------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=firmanrio59@gmail.com
EMAIL_PASSWORD=dbssgigsqowlxxcq

# -----------------------------------------------------------------------------
# MIDTRANS CONFIGURATION (existing)
# -----------------------------------------------------------------------------
MIDTRANS_SERVER_KEY=your-midtrans-server-key
MIDTRANS_CLIENT_KEY=your-midtrans-client-key
MIDTRANS_IS_PRODUCTION=false
