PORT=5000
NODE_ENV=development

# Gunakan nama service dari docker-compose, bukan localhost
DB_MASTER_HOST=mysql-master
DB_SLAVE_HOST=mysql-slave
DB_PORT=3306

# Kredensial harus sama dengan di docker-compose.yml
DB_USER=konseruser
DB_PASSWORD=konserpassword
DB_NAME=konser_yuk

# Sesuaikan dengan config JWT kamu (access & refresh jika ada)
JWT_ACCESS_SECRET=your_super_secret_jwt_key_access
JWT_REFRESH_SECRET=your_super_secret_jwt_key_refresh

# Redis Configuration (Gunakan nama service 'redis')
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redispassword

# Midtrans & Email (Sudah benar)
MIDTRANS_SERVER_KEY=SB-Mid-server-YOUR_SERVER_KEY
MIDTRANS_CLIENT_KEY=SB-Mid-client-YOUR_CLIENT_KEY
MIDTRANS_IS_PRODUCTION=false

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
